# Copy this to .env and fill in the values
# ------------------------------------
# Gemini AI API Key (get free from https://aistudio.google.com/apikey)
VITE_GEMINI_API_KEY=AIzaSy_YOUR_KEY_HERE

# Your Render backend URL (example: https://farmai-backend.onrender.com)
# Leave empty to use localhost:3001 for local dev
VITE_API_URL=https://YOUR-BACKEND-NAME.onrender.com
